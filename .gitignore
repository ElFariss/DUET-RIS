.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.cache/
.env
.env.*
*.pem
*.key
*.log
# Large, hash-inventoried artifacts stay in the local/remote workspace.
data/raw/acquisition/
data/raw/deepmimo_scenarios/
data/processed/**/*.npz
outputs/runs/*/models/*/best.pt
outputs/runs/*/models/*/scaling.npz
outputs/runs/*/feature_scaling.npz
outputs/runs/*/mesh_audit/*.npz
outputs/runs/*/*_labels.npz
outputs/runs/*/sensitivity.json
outputs/runs/*/benchmark_*.jsonl
# Large recovery and improvement-campaign payloads stay local; retain their compact JSON provenance.
outputs/recovered/**/*.pt
outputs/recovered/**/*.npz
outputs/recovered/**/*.npy
outputs/recovered/**/*.tar.gz
outputs/recovered/**/*.jsonl
outputs/campaigns/**/models/**/*.pt
outputs/campaigns/**/*.npz
outputs/campaigns/**/*.jsonl
# 2026-11-06 fresh model runs are nested one level deeper than the legacy outputs/runs rule.
outputs/runs/*_improvement_remote_20261106/**/models/**/*.pt
outputs/runs/*_improvement_remote_20261106/**/*.npz
outputs/runs/*_improvement_remote_20261106/**/*.jsonl
# Preserve source/history locally without duplicating it in the initial repository.
archives/
paper/**/*.aux
paper/**/*.out
paper/**/*.synctex.gz
paper/**/*.toc
artifact-manifest.json

# DeepMIMO uses this optional root link for locating existing scenario exports.
/deepmimo_scenarios
/build/
/dist/

.venv-*/

# Downloaded reference implementations remain local; publish provenance only.
/data/raw/em_reference/*/
